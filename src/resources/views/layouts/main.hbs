    <title>NOTFlEX - Niềm Vui Của Mọi Nhà</title>
</head>
<body>
    {{> header}}

    {{{body}}}

    {{> footer}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const categoryButton = document.querySelector(
                ".header__directory-link.category"
            );

            const categoryMenu = document.querySelector(
                ".header__directory--category"
            );

            if (categoryButton && categoryMenu) {
                categoryButton.addEventListener("click", function (event) {
                    event.preventDefault();

                    const isOpen =
                        categoryMenu.style.visibility === "visible";

                    categoryMenu.style.visibility =
                        isOpen ? "hidden" : "visible";

                    categoryMenu.style.opacity =
                        isOpen ? "0" : "1";

                    categoryMenu.style.display =
                        isOpen ? "none" : "block";
                });
            }
        });
    </script>
</body>
</html>
