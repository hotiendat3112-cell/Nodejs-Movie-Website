<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div style="width: 100%; max-width: 450px; background: rgba(0, 0, 0, 0.85); padding: 50px 40px; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); color: #fff;">
        <h2 style="font-size: 28px; font-weight: bold; margin-bottom: 25px; text-align: center;">Đăng Ký Tài Khoản</h2>
        
        {{#if error}}
            <div style="background: #e50914; color: #fff; padding: 10px 15px; border-radius: 4px; margin-bottom: 20px; text-align: center; font-size: 14px;">
                {{error}}
            </div>
        {{/if}}

        <form action="/register" method="POST">
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 14px; margin-bottom: 6px; color: #bbb;">Tên hiển thị</label>
                <input type="text" name="username" required placeholder="Nhập tên hiển thị" style="width: 100%; padding: 12px 15px; border-radius: 4px; border: 1px solid #333; background: #333; color: #fff; outline: none; font-size: 15px;">
            </div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 14px; margin-bottom: 6px; color: #bbb;">Email</label>
                <input type="email" name="email" required placeholder="Nhập email" style="width: 100%; padding: 12px 15px; border-radius: 4px; border: 1px solid #333; background: #333; color: #fff; outline: none; font-size: 15px;">
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; font-size: 14px; margin-bottom: 6px; color: #bbb;">Mật khẩu</label>
                <input type="password" name="password" required placeholder="Nhập mật khẩu" style="width: 100%; padding: 12px 15px; border-radius: 4px; border: 1px solid #333; background: #333; color: #fff; outline: none; font-size: 15px;">
            </div>

            <button type="submit" style="width: 100%; padding: 12px; background: #e50914; color: #fff; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;">
                Đăng Ký
            </button>
        </form>

        <p style="text-align: center; margin-top: 25px; color: #aaa; font-size: 14px;">
            Đã có tài khoản? <a href="/login" style="color: #fff; font-weight: bold; text-decoration: underline;">Đăng nhập</a>
        </p>
    </div>
</div>