<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
    <div style="width: 100%; max-width: 450px; background: rgba(0, 0, 0, 0.85); padding: 50px 40px; border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); color: #fff;">
        <h2 style="font-size: 28px; font-weight: bold; margin-bottom: 25px; text-align: center;">Đăng Nhập</h2>
        
        {{#if error}}
            <div style="background: #e50914; color: #fff; padding: 10px 15px; border-radius: 4px; margin-bottom: 20px; text-align: center; font-size: 14px;">
                {{error}}
            </div>
        {{/if}}

        <form action="/login" method="POST">
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 14px; margin-bottom: 6px; color: #bbb;">Email</label>
                <input type="email" name="email" required placeholder="Nhập email của bạn" style="width: 100%; padding: 12px 15px; border-radius: 4px; border: 1px solid #333; background: #333; color: #fff; outline: none; font-size: 15px;">
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; font-size: 14px; margin-bottom: 6px; color: #bbb;">Mật khẩu</label>
                <input type="password" name="password" required placeholder="Nhập mật khẩu" style="width: 100%; padding: 12px 15px; border-radius: 4px; border: 1px solid #333; background: #333; color: #fff; outline: none; font-size: 15px;">
            </div>

            <button type="submit" style="width: 100%; padding: 12px; background: #e50914; color: #fff; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer; transition: 0.3s;">
                Đăng Nhập
            </button>
        </form>

        <div style="display: flex; align-items: center; margin: 25px 0;">
            <div style="flex: 1; height: 1px; background: #444;"></div>
            <span style="padding: 0 10px; color: #888; font-size: 13px;">HOẶC</span>
            <div style="flex: 1; height: 1px; background: #444;"></div>
        </div>

        <!-- Nút Đăng Nhập Google -->
        <a href="/auth/google" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 11px; background: #fff; color: #333; border-radius: 4px; text-decoration: none; font-weight: 600; font-size: 14px; box-sizing: border-box;">
            <svg width="18" height="18" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            Đăng nhập với Google
        </a>

        <p style="text-align: center; margin-top: 25px; color: #aaa; font-size: 14px;">
            Chưa có tài khoản? <a href="/register" style="color: #fff; font-weight: bold; text-decoration: underline;">Đăng ký ngay</a>
        </p>
    </div>
</div>